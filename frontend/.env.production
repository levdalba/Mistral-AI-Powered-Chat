# Production Environment Variables for Vercel Deployment
# Copy these to your Vercel project settings

# Backend API URL (Render deployment)
NEXT_PUBLIC_API_BASE_URL=https://mistral-ai-powered-chat.onrender.com

# Application Settings
NEXT_PUBLIC_APP_NAME=Mistral AI Chat
NEXT_PUBLIC_APP_DESCRIPTION=Intelligent conversations powered by Mistral AI

# Features
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DOCUMENT_UPLOAD=false

# Performance
NEXT_PUBLIC_API_TIMEOUT=30000
