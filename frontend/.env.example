# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_TIMEOUT=30000

# Application Settings
NEXT_PUBLIC_APP_NAME="Mistral AI Chat"
NEXT_PUBLIC_APP_DESCRIPTION="AI-Powered Chat & Knowledge Assistant"
NEXT_PUBLIC_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_SUPPORTED_FORMATS=pdf,txt,docx

# Feature Flags
NEXT_PUBLIC_ENABLE_DOCUMENT_QA=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_THEMES=true
NEXT_PUBLIC_ENABLE_OFFLINE=true

# Chat Configuration
NEXT_PUBLIC_MAX_CONTEXT_MESSAGES=20
NEXT_PUBLIC_DEFAULT_MODEL=mistral-large-latest
NEXT_PUBLIC_MAX_MESSAGE_LENGTH=4000

# UI Configuration
NEXT_PUBLIC_ITEMS_PER_PAGE=20
NEXT_PUBLIC_DEBOUNCE_DELAY=300
NEXT_PUBLIC_ANIMATION_DURATION=200

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# Development
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_MOCK_API=false
