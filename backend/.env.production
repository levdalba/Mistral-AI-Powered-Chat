# Production Environment Variables for Railway Deployment
# Set these in your Railway project settings

# Mistral AI Configuration (REQUIRED)
MISTRAL_API_KEY=your_mistral_api_key_here

# Application Settings
ENVIRONMENT=production
DEBUG=false
VERSION=1.0.0

# Security
SECRET_KEY=your-production-secret-key-here

# CORS - Update with your actual frontend domain
ALLOWED_ORIGINS=["https://mistral-ai-chat-rdnjuqftd-levdalbas-projects.vercel.app","http://localhost:3000","http://localhost:3001"]

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
